; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it is also readable and editable by hand.
; Format is INI-like. Keep this file in git.

config_version=5

[application]

config/name="Wayfarer"
config/description="First-person hard sci-fi salvage game with real orbital flight."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_property_access=1

[autoload]

Sim="*res://scripts/world/orbital_session.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=3
window/stretch/mode="canvas_items"

[input]

